<h1><%= t(".title") %></h1>
<%= form_with(scope: :session, url: sessions_path, local: true) do |f| %>
  <div class="field">
    <%= f.label t(".email") %>
    <%= f.email_field :email %>
  </div>
  <div class="field">
    <%= f.label t(".password") %>
    <%= f.password_field :password %>
  </div>
  <div id="create-session">
    <%= f.submit t("common.sign_in") %>
  </div>
<% end %>
